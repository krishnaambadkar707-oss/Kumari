# ───────────────────────────── Kumari settings ─────────────────────────────
# Copy of this file is created as ".env" on first run. Edit ".env", save,
# and restart Kumari. Lines starting with # are ignored.

# ── 1. A brain (you need at least ONE of these; Gemini is free) ─────────────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional extras. If one is down or out of quota, Kumari tries the next.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Fully offline option: install Ollama (https://ollama.com), run
#   ollama pull qwen2.5:7b
# and Kumari uses it automatically when no cloud key works.

# Which brain to prefer: auto | gemini | groq | anthropic | openai | ollama
KUMARI_LLM_PROVIDER=auto

# Leave on "auto" so the newest working Gemini model is picked for you.
KUMARI_GEMINI_MODEL=auto

# ── 2. You ──────────────────────────────────────────────────────────────────
KUMARI_USER_NAME=Krishna
# Used for "what's the weather" when you don't name a city.
KUMARI_CITY=Nagpur

# ── 3. Language ─────────────────────────────────────────────────────────────
# What the microphone listens for. hi-IN understands Hindi AND Hinglish;
# en-IN is best for plain English. Press L in the app to switch any time.
KUMARI_STT_LANG=hi-IN
# auto = reply in the language you spoke | hi | en
KUMARI_LANGUAGE=auto

# ── 4. Optional ─────────────────────────────────────────────────────────────
# KUMARI_PORT=8787
# KUMARI_ALLOW_POWER=true      # false = never shut down / restart / sleep
# ELEVENLABS_API_KEY=          # nicer voice (optional; browser voice is default)
# KUMARI_DEBUG=false
